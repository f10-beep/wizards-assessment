# Leave unset for local development — the app falls back to an embedded
# PGlite database at ./.pglite/dev (see README "Local development").
#
# Set this to Neon's POOLED connection string in production (the one with
# "-pooler" in the hostname) — the app opens real sessions/transactions
# for capacity-safe RSVP writes, so it must go through Neon's pooler
# rather than a direct connection. See
# docs/decisions/0003-neon-pooled-transactional-driver.md.
DATABASE_URL=

# Comma-separated extra origins allowed to reach the Next.js dev server,
# e.g. your workstation's LAN IP if you load it from something other than
# localhost. Dev-only — see next.config.ts. Leave unset if not needed.
ALLOWED_DEV_ORIGINS=
